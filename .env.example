# Copy to `.env` (gitignored) before running docker compose / make test-db.
# Or run `make init` once.

# Root password for the bundled MySQL container (also used as DJ_PASS).
MYSQL_ROOT_PASSWORD=changeme

# Laptop port forwarded to MySQL in the container (MySQL's default there is 3306).
# Change if that host port is already in use (e.g. 3307).
MYSQL_PUBLISH_PORT=3306

# Host directory for MySQL data and files shared with the client container.
DATABASE_MOUNT=./.dbdata

# Prefix for all DataJoint schema names. Must include the trailing underscore.
DJ_SCHEMA_PREFIX=dev_

# Opaque stable id for this DB/instance/dataset (default for register_session).
SCENE_DEPLOYMENT_ID=local-dev
# Optional human label stored on Deployment when using the env default.
SCENE_DEPLOYMENT_LABEL=local-dev
